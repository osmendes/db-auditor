  "components": {
    "schemas": {
      "CAGGDetailSnapshot": {
        "type":"object",
        "required":["id","environment_id","audit_run_id","database_name","schema_name","view_name","materialized_only","compression_enabled","lag_interval","definition_fingerprint","collected_at"],
        "properties":{
          "id":{"type":"string"},"environment_id":{"type":"string"},"audit_run_id":{"type":"string"},
          "database_name":{"type":"string"},"schema_name":{"type":"string"},"view_name":{"type":"string"},
          "owner_name":{"type":["string","null"]},"materialization_schema":{"type":["string","null"]},
          "materialization_hypertable":{"type":["string","null"]},"materialized_only":{"type":"boolean"},
          "compression_enabled":{"type":"boolean"},"finalized":{"type":["boolean","null"]},
          "source_hypertable_schema":{"type":["string","null"]},"source_hypertable_name":{"type":["string","null"]},
          "bucket_interval":{"type":["string","null"]},
          "lag_interval":{"type":"string"},"definition_fingerprint":{"type":"string"},
          "materialization_size_bytes":{"type":["integer","null"]},"collected_at":{"type":"string"}
        }
      },
      "HypertableDetailSnapshot": {
        "type":"object",
        "required":["id","audit_run_id","environment_id","database_name","schema_name","hypertable_name","num_dimensions","num_chunks","compression_enabled","is_distributed","total_size_bytes","data_size_bytes","index_size_bytes","collected_at","base_table_observed"],
        "properties":{
          "id":{"type":"string"},"audit_run_id":{"type":"string"},"environment_id":{"type":"string"},
          "database_name":{"type":"string"},"schema_name":{"type":"string"},"hypertable_name":{"type":"string"},
          "owner_name":{"type":["string","null"]},"num_dimensions":{"type":"integer"},"num_chunks":{"type":"integer"},
          "compression_enabled":{"type":"boolean"},"is_distributed":{"type":"boolean"},
          "total_size_bytes":{"type":"integer"},"data_size_bytes":{"type":"integer"},"index_size_bytes":{"type":"integer"},
          "collected_at":{"type":"string"},"base_table_observed":{"type":"boolean"}
        }
      },
      "FunctionDetailSnapshot": {
        "type":"object",
        "required":["id","environment_id","audit_run_id","database_name","schema_name","function_name","identity_arguments","is_security_definer","collected_at"],
        "properties":{
          "id":{"type":"string"},"environment_id":{"type":"string"},"audit_run_id":{"type":"string"},
          "database_name":{"type":"string"},"schema_name":{"type":"string"},"function_name":{"type":"string"},"identity_arguments":{"type":"string"},
          "owner_name":{"type":["string","null"]},"language_name":{"type":["string","null"]},"is_security_definer":{"type":"boolean"},
          "volatility":{"type":["string","null"]},"parallel_safety":{"type":["string","null"]},"kind":{"type":["string","null"]},
          "return_type":{"type":["string","null"]},"search_path_pinned":{"type":["boolean","null"]},
          "execute_role_count":{"type":["integer","null"]},
          "calls":{"type":["integer","null"]},"total_time_ms":{"type":["number","null"]},"self_time_ms":{"type":["number","null"]},
          "stats_reset":{"type":["string","null"]},"stats_observed":{"type":["boolean","null"]},
          "definition_fingerprint":{"type":"string"},"collected_at":{"type":"string"}
        }
      },
      "IndexDetailSnapshot": {
        "type": "object",
        "required": ["id", "environment_id", "audit_run_id", "database_name", "schema_name", "table_name", "index_name", "is_unique", "is_primary", "is_valid", "is_ready", "is_partial", "size_bytes", "idx_scan", "idx_tup_read", "idx_tup_fetch", "collected_at"],
        "properties": {
          "id": {"type":"string"}, "environment_id": {"type":"string"}, "audit_run_id": {"type":"string"},
          "database_name": {"type":"string"}, "schema_name": {"type":"string"}, "table_name": {"type":"string"},
          "table_owner_name": {"type":["string","null"]}, "index_name": {"type":"string"}, "access_method": {"type":["string","null"]},
          "is_unique": {"type":"boolean"}, "is_primary": {"type":"boolean"}, "is_valid": {"type":"boolean"}, "is_ready": {"type":"boolean"},
          "key_columns": {"type":["array","null"],"items":{"type":"string"}}, "include_columns": {"type":["array","null"],"items":{"type":"string"}},
          "is_partial": {"type":"boolean"}, "definition_fingerprint": {"type":"string"}, "predicate_fingerprint": {"type":"string"},
          "size_bytes": {"type":"integer"}, "idx_scan": {"type":"integer"}, "idx_tup_read": {"type":"integer"}, "idx_tup_fetch": {"type":"integer"},
          "stats_reset": {"type":["string","null"]}, "usage_observed": {"type":["boolean","null"]}, "collected_at": {"type":"string"}
        }
      },
      "ViewDetailSnapshot": {
        "type": "object",
        "required": ["id", "environment_id", "audit_run_id", "database_name", "schema_name", "view_name", "relkind", "size_bytes", "collected_at"],
        "properties": {
          "id": {"type":"string"}, "environment_id": {"type":"string"}, "audit_run_id": {"type":"string"},
          "database_name": {"type":"string"}, "schema_name": {"type":"string"}, "view_name": {"type":"string"},
          "owner_name": {"type":["string","null"]}, "relkind": {"type":"string"}, "size_bytes": {"type":"integer"},
          "columns": {"type":["array","null"],"items":{"type":"object"}},
          "security_invoker": {"type":["boolean","null"]}, "security_barrier": {"type":["boolean","null"]},
          "is_populated": {"type":["boolean","null"]}, "definition_fingerprint": {"type":"string"},
          "collected_at": {"type":"string"}
        }
      },
      "ScopeScoreCategory": {
        "type": "object",
        "required": ["category", "weight", "score", "penalty", "positive", "findings"],
        "properties": {
          "category": { "type": "string" },
          "weight": { "type": "integer" },
          "score": { "type": "integer" },
          "penalty": { "type": "integer" },
          "positive": { "type": "integer", "description": "Pontos por evidência positiva verificada no escopo." },
          "findings": { "type": "integer" }
        }
      },
      "ScopeScore": {
        "type": "object",
        "required": ["version", "profile", "collector_version", "rule_version", "environment_id", "audit_run_id", "status", "score", "confidence", "categories", "missing_collectors", "explanation"],
        "properties": {
          "version": { "type": "string" },
          "profile": { "type": "string" },
          "collector_version": { "type": "string" },
          "rule_version": { "type": "string" },
          "environment_id": { "type": "string" },
          "audit_run_id": { "type": "string" },
          "database_name": { "type": "string" },
          "schema_name": { "type": "string" },
          "table_name": { "type": "string" },
          "status": { "type": "string" },
          "score": { "type": ["integer", "null"] },
          "confidence": { "type": "number" },
          "explanation": { "type": "string" },
          "categories": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ScopeScoreCategory" }
          },
          "missing_collectors": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
