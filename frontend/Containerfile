# Multi-stage production build for the React UI (static assets + Caddy serve optional).
FROM oven/bun:1.2-alpine AS build
WORKDIR /app
COPY package.json bun.lockb* ./
RUN bun install --frozen-lockfile || bun install
COPY . .
ARG VITE_API_BASE_URL=/
ARG VITE_COMPANY_NAME=db-auditor
ARG VITE_ARCHITECTURE_REPORT_ENABLED=false
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_COMPANY_NAME=$VITE_COMPANY_NAME
ENV VITE_ARCHITECTURE_REPORT_ENABLED=$VITE_ARCHITECTURE_REPORT_ENABLED
RUN bun run build

FROM caddy:2.9-alpine
COPY --from=build /app/dist /srv
COPY Caddyfile.static /etc/caddy/Caddyfile
EXPOSE 80
