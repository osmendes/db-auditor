# Copy to .env and use a locally generated development password.
# Never commit real credentials.
#
# Host requirements: Podman (or Docker) + Compose only.
# Languages and tools run inside containers via `make`.
#
# Product: DB Auditor (repo: db-auditor)
#
# --- Seed demo UUIDs (02_seed_demo.sql / UI) — não alterar sem migrar dados ---
#   Tiger Cloud demo:  00000000-0000-0000-0000-000000000001
#   Datacenter demo:   00000000-0000-0000-0000-000000000002
# AUDITOR_TARGET_N_ENVIRONMENT_ID deve coincidir com um desses (ou ambientes criados na UI).

# --- Snapshot store (Postgres do próprio Auditor) ---------------------------
POSTGRES_DB=db_auditor
POSTGRES_USER=auditor
POSTGRES_PASSWORD=change-me-locally

AUDITOR_HTTP_PORT=8080
# Primeiro acesso da tela de login. Usuário e senha ficam aqui.
# A senha precisa ter pelo menos 16 caracteres. Troque antes de expor o serviço.
# A conta operator só é criada se auditor_user estiver vazia.
# Se todos os operadores perderem acesso, use o procedimento recover-operator
# após confirmar um backup restaurável. Nunca apague auditor_user.
AUDITOR_BOOTSTRAP_USER=admin
AUDITOR_BOOTSTRAP_PASSWORD=db-auditor-local-1
# Opcional. Usado somente quando AUDITOR_BOOTSTRAP_PASSWORD está vazio.
# AUDITOR_BOOTSTRAP_PASSWORD_FILE=/run/secrets/bootstrap-password
# Token legado usado apenas quando a API é iniciada sem autenticação local (testes antigos).
# AUDITOR_REPORT_API_TOKEN=
AUDITOR_STATEMENT_TIMEOUT=15s
AUDITOR_LOCK_TIMEOUT=5s
AUDITOR_MAX_CONCURRENT_RUNS=2
AUDITOR_MAX_COLLECTOR_WORKERS=4
AUDITOR_MAX_DATABASE_CONNECTIONS=4
AUDITOR_TARGET_STATEMENT_TIMEOUT=15s
AUDITOR_OPTIONAL_COLLECTOR_TIMEOUT=2m
AUDITOR_OPTIONAL_MAX_PLAN_COST=100000
# Alertas opcionais. Sem webhook e sem SMTP, o auditor não envia nada.
# O payload não inclui DSN, senha nem SQL. Falha de envio não falha a execução.
# AUDITOR_ALERT_WEBHOOK_URL=
# AUDITOR_ALERT_EMAIL_TO=
# AUDITOR_ALERT_EMAIL_FROM=auditor@example.com
# AUDITOR_ALERT_SMTP_HOST=
# AUDITOR_ALERT_SMTP_PORT=587
# AUDITOR_ALERT_SMTP_USER=
# AUDITOR_ALERT_SMTP_PASSWORD=
# Hosts exatos autorizados para bancos auditados. Obrigatório se algum TARGET_*_HOST estiver definido.
# AUDITOR_TARGET_ALLOWED_HOSTS=db1.example.com,db2.example.com
# Allowlist explícita e vazia por padrão. Sem um host aqui, TLS fraco é recusado.
# AUDITOR_TARGET_INSECURE_HOSTS=
# Cifra o segredo TOTP. Obrigatória só para ativar MFA. Mínimo de 16 caracteres.
# AUDITOR_TOTP_KEY=
# AUDITOR_REPORT_REDACT_METADATA=requested_by,environment

# Logging: json (default) or text; level debug|info|warn|error
# AUDITOR_LOG_FORMAT=json
# AUDITOR_LOG_LEVEL=info

# CORS: comma-separated browser origins allowed to call the API.
# Empty = localhost:5173 / 5174 (dev). Production: set your UI origin(s).
# AUDITOR_CORS_ORIGINS=http://localhost:5173,https://auditor.example.com

# Escopo de coleta (lista separada por vírgula).
# Allowlist vazia = todos os nomes não negados. Denylist sempre vence.
AUDITOR_DATABASE_DENYLIST=template0,template1,postgres
AUDITOR_SCHEMA_DENYLIST=pg_catalog,information_schema
# AUDITOR_DATABASE_ALLOWLIST=
# AUDITOR_SCHEMA_ALLOWLIST=

# Coletores opcionais da Sprint 15. Ambos persistem somente agregados/metadados.
AUDITOR_COLUMN_STATS_ENABLED=true
AUDITOR_COLUMN_STATS_LIMIT=5000
# AUDITOR_COLUMN_STATS_SCHEMA_ALLOWLIST=public
AUDITOR_WORKLOAD_ENABLED=true
AUDITOR_WORKLOAD_LIMIT=500

# --- Ambientes auditados (somente leitura) ---------------------------------
# Credenciais ficam aqui, nunca em migration. 02_seed_demo.sql só cria o rótulo
# local (nome/tipo) dos dois UUIDs abaixo, e só em volume vazio.
# O ENVIRONMENT_ID do slot tem de ser o id já existente em audit_environment.
# Após alterar: make down && make up
#
# Slot 1 — Demo Tiger Cloud (seed: 00000000-0000-0000-0000-000000000001)
AUDITOR_TARGET_1_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000001
AUDITOR_TARGET_1_HOST=
AUDITOR_TARGET_1_PORT=5432
AUDITOR_TARGET_1_DATABASE=
AUDITOR_TARGET_1_USER=
AUDITOR_TARGET_1_PASSWORD=
AUDITOR_TARGET_1_SSLMODE=verify-full

# Slot 2 — Demo Datacenter (seed: 00000000-0000-0000-0000-000000000002)
AUDITOR_TARGET_2_ENVIRONMENT_ID=00000000-0000-0000-0000-000000000002
AUDITOR_TARGET_2_HOST=
AUDITOR_TARGET_2_PORT=5432
AUDITOR_TARGET_2_DATABASE=
AUDITOR_TARGET_2_USER=
AUDITOR_TARGET_2_PASSWORD=
AUDITOR_TARGET_2_SSLMODE=verify-full

# Slots 3..20 seguem o mesmo padrão (AUDITOR_TARGET_N_*).
# Fallback legado (URI completa), se preferir:
# AUDITOR_TARGET_DSN_00000000_0000_0000_0000_000000000001=postgresql://user:pass@host:5432/db?sslmode=verify-full

# Frontend host port (container always listens on 5173).
# If you see "bind: address already in use", pick a free port, e.g. 5174.
FRONTEND_HTTP_PORT=5173
# Browser → API through the same-origin frontend proxy (required for cookie sessions).
VITE_API_BASE_URL=/
