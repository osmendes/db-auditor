# Copy to the repository root as .env.prod. Never commit that copy.
#   podman compose -f deploy/compose.prod.yaml --env-file .env.prod up -d
#
# The compose file fails closed when POSTGRES_PASSWORD, AUDITOR_BOOTSTRAP_USER,
# AUDITOR_BOOTSTRAP_PASSWORD, AUDITOR_CORS_ORIGINS or AUDITOR_TARGET_ALLOWED_HOSTS
# are empty. Target slots travel via env_file; do not put them in the YAML.

POSTGRES_DB=db_auditor
POSTGRES_USER=auditor
POSTGRES_PASSWORD=

AUDITOR_BOOTSTRAP_USER=admin
AUDITOR_BOOTSTRAP_PASSWORD=

# Nome da empresa, mostrado debaixo do título. Na imagem de produção ele entra no build.
AUDITOR_COMPANY_NAME=db-auditor

AUDITOR_CORS_ORIGINS=https://auditor.example.com
AUDITOR_TARGET_ALLOWED_HOSTS=tiger.example.com,dc.example.com

AUDITOR_TARGET_1_NAME=Banco principal
AUDITOR_TARGET_1_TYPE=self_hosted
AUDITOR_TARGET_1_DISCOVERY=single_database
AUDITOR_TARGET_1_ENVIRONMENT_ID=
AUDITOR_TARGET_1_HOST=
AUDITOR_TARGET_1_PORT=5432
AUDITOR_TARGET_1_DATABASE=
AUDITOR_TARGET_1_USER=
AUDITOR_TARGET_1_PASSWORD=
AUDITOR_TARGET_1_SSLMODE=verify-full

AUDITOR_TARGET_2_NAME=Banco de homologação
AUDITOR_TARGET_2_TYPE=self_hosted
AUDITOR_TARGET_2_DISCOVERY=single_database
AUDITOR_TARGET_2_ENVIRONMENT_ID=
AUDITOR_TARGET_2_HOST=
AUDITOR_TARGET_2_PORT=5432
AUDITOR_TARGET_2_DATABASE=
AUDITOR_TARGET_2_USER=
AUDITOR_TARGET_2_PASSWORD=
AUDITOR_TARGET_2_SSLMODE=verify-full

# MongoDB opcional: crie o ambiente no snapshot store com engine='mongodb'.
# Use uma conta que só pode listar coleções, índices e estatísticas.
# Inclua o host abaixo em AUDITOR_TARGET_ALLOWED_HOSTS.
# AUDITOR_TARGET_3_ENGINE=mongodb
# AUDITOR_TARGET_3_ENVIRONMENT_ID=
# AUDITOR_TARGET_3_HOST=
# AUDITOR_TARGET_3_PORT=27017
# AUDITOR_TARGET_3_DATABASE=
# AUDITOR_TARGET_3_USER=
# AUDITOR_TARGET_3_PASSWORD=

# Optional alerts. Leave unset to disable. Do not put DSNs in the webhook.
# AUDITOR_ALERT_WEBHOOK_URL=
# AUDITOR_ALERT_EMAIL_TO=
# AUDITOR_ALERT_EMAIL_FROM=
# AUDITOR_ALERT_SMTP_HOST=
# AUDITOR_ALERT_SMTP_PORT=587
# AUDITOR_ALERT_SMTP_USER=
# AUDITOR_ALERT_SMTP_PASSWORD=
